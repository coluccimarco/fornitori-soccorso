%% Logical packages and external components; UI and routing remain future work.
flowchart LR
    HTTP["REST clients"] --> Controller["controller<br/>Auth / Registry / Mission / Chat"]
    Controller --> DTO["dto + validation"]
    Controller --> Service["service<br/>use case / transactions"]
    Service --> Repo["repository<br/>JPA / locks"]
    Repo --> Entity["entity + enums"]
    Repo --> DB[("PostgreSQL")]
    Config["config<br/>security / clock"] -. configures .-> Controller
    Common["common<br/>API/domain errors"] -. shared .-> Controller
    Bot["Python chatbot"] -->|HTTP + service bearer| Controller
    Telegram["Telegram channel"] --> Bot
    Maps["Map UI/provider<br/>future"] -. future .-> HTTP
