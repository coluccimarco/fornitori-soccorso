%% Container view: solid lines are present in code; dotted lines are not integrated.
flowchart TB
    subgraph Client["Client"]
        Ops["Responsabile"]
        Driver["Autista"]
        Customer["Cliente"]
        Web["Browser client<br/>HTML / CSS / JavaScript"]
        Bot["Chatbot Python<br/>engine + HTTP backend"]
        Telegram["Canale Telegram<br/>long polling"]
    end
    subgraph App["Applicazione FORNITORI"]
        Static["Static resources<br/>Spring Boot"]
        API["REST API<br/>Spring Boot / Java 25"]
        Service["Application services<br/>auth / mission / chat / maps / pricing"]
        Persistence["Spring Data JPA"]
    end
    DB[("PostgreSQL 18")]
    Geocoder["Nominatim"]
    Router["OSRM"]
    WhatsApp["WhatsApp<br/>non implementato"]
    Ops --> Web
    Driver --> Web
    Web -->|"same-origin session + CSRF"| Static
    Static --> API
    Customer --> Telegram
    Telegram --> Bot
    Bot -->|"service token"| API
    API --> Service --> Persistence --> DB
    Service -->|"geocoding"| Geocoder
    Service -->|"routing"| Router
    Bot -. "outbox API / polling" .-> API
    Bot -.-> WhatsApp
