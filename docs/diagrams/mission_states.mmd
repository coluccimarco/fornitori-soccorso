%% Stati per missioni LIVE nel backend; fixture storiche restano immutate.
stateDiagram-v2
    state "In assegnazione" as aperta {
        [*] --> nuova
        nuova --> proposta: proposta automatica o manuale
        proposta --> non_accettata: autista rifiuta
        proposta --> scaduta: deadline raggiunta
        non_accettata --> proposta: autista successivo
        scaduta --> proposta: autista successivo
        non_accettata --> gestione_manuale: terzo esito negativo
        scaduta --> gestione_manuale: terzo esito negativo
        gestione_manuale --> proposta: centrale propone
    }
    [*] --> aperta: centrale, o bot con polizza verificata
    [*] --> verifica_polizza: bot con polizza non verificabile
    verifica_polizza --> aperta: centrale conferma
    verifica_polizza --> annullata: centrale respinge
    aperta --> accettata: autista accetta la proposta entro 10 min
    aperta --> annullata: centrale annulla
    accettata --> eseguita: chiusura OK
    accettata --> annullata: centrale o autista annulla
    eseguita --> [*]
    annullata --> [*]
